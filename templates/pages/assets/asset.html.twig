{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set params  = params ?? [] %}

{% block more_fields %}
    {% if item.isNewItem() %}
        {{ fields.hiddenField(
            'Glpi\\Asset\\AssetDefinition'|itemtype_foreign_key,
            _get['Glpi\\Asset\\AssetDefinition'|itemtype_foreign_key]|default(0),
        ) }}
    {% endif %}

    {# CMMS: for medical equipment, the generic Type / Model / Location fields
       are hidden (see the seed's fields_display) and re-rendered here with
       a Department label and cascading Manufacturer -> Type -> Model dropdowns. #}
    {% if 'medical_equipment' in item.getType() %}
        {% set type_field = item.getTypeForeignKeyField() %}
        {% set model_field = item.getModelForeignKeyField() %}
        {% set cmms_def_id = item.fields['assets_assetdefinitions_id']|default(0) %}
        {% if cmms_def_id == 0 and _get['assets_assetdefinitions_id'] is defined %}
            {% set cmms_def_id = _get['assets_assetdefinitions_id'] %}
        {% endif %}

        <div class="row">
            <div class="col-12">
                {{ fields.dropdownField(
                    'Location',
                    'locations_id',
                    item.fields['locations_id'],
                    __('Department'),
                    {
                        'entity': item.fields['entities_id']|default(-1),
                    }
                ) }}
            </div>
            <div class="col-12" id="cmms_type_model_fields">
                {{ fields.dropdownField(item.getTypeClass(), type_field, item.fields[type_field], _n('Type', 'Types', 1)) }}
                {{ fields.dropdownField(item.getModelClass(), model_field, item.fields[model_field], _n('Model', 'Models', 1)) }}
            </div>
        </div>

        <script>
            $(function () {
                var cmmsDefId = {{ cmms_def_id }};
                var $zone = $('#cmms_type_model_fields');
                if (!cmmsDefId || !$zone.length) {
                    return;
                }
                var cmmsUrl = {{ config('root_doc')|json_encode|raw }} + '/ajax/cmms_equipment_fields.php';
                var reloadCascade = function () {
                    $zone.load(cmmsUrl, {
                        'assets_assetdefinitions_id': cmmsDefId,
                        'manufacturers_id': $('select[name="manufacturers_id"]').val() || 0,
                        'assets_assettypes_id': $zone.find('select[name="assets_assettypes_id"]').val() || 0,
                        'assets_assetmodels_id': $zone.find('select[name="assets_assetmodels_id"]').val() || 0
                    });
                };
                $(document).on('change', 'select[name="manufacturers_id"]', reloadCascade);
                $zone.on('change', 'select[name="assets_assettypes_id"]', reloadCascade);
                reloadCascade();
            });
        </script>
    {% endif %}
{% endblock %}
